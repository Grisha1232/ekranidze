# Copy to .env and fill in. Never commit the real .env file.

PORT=8787
# Exact origin the static site is served from, e.g. https://grisha1232.github.io
# (or the final custom domain, once registered). "*" works for local testing only.
ALLOWED_ORIGIN=*

# --- Telegram bot per restaurant --------------------------------------------
# Create each bot via @BotFather in Telegram (/newbot), add it to the
# restaurant's staff chat, and find the chat's id (e.g. by messaging the bot
# and checking https://api.telegram.org/bot<token>/getUpdates).
# Until a restaurant's pair below is filled in, its orders are only logged to
# the server console (stub mode) — nothing breaks, nothing is lost silently.

# Экранидзе
TG_BOT_TOKEN_EKRANIDZE=
TG_CHAT_ID_EKRANIDZE=

# Мама хинкали (ул. Шухова — the operating location; add a separate pair here
# if the Духовской пер. location needs its own notifications once it opens)
TG_BOT_TOKEN_MAMA_HINKALI=
TG_CHAT_ID_MAMA_HINKALI=
