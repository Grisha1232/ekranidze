# Apache's own directory-slash redirect (mod_dir) fires on a bare route
# name before mod_rewrite's rules below ever run, since every route here
# has a same-named directory (the RSC payload folder) — turning it off lets
# the extensionless→.html rewrite below actually be reached.
DirectorySlash Off

RewriteEngine On

# Принудительный https. На Timeweb SSL терминируется на nginx перед Apache,
# поэтому стандартный %{HTTPS} всегда "off" здесь — проверяем через
# заголовок от прокси.
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Next's static export writes both a route/ directory of RSC payloads *and*
# a route.html file for the same path. Deliberately NOT excluding `-d`
# matches here: every route has a same-named directory (the RSC payload
# folder, no index.html inside it), so without this rewrite Apache's own
# directory handling wins first — DirectorySlash redirects /route to
# /route/ (over plain http, since Apache doesn't know nginx already
# terminated TLS), then 403s since that directory has no index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Timeweb's server-level config sends a 1-year Cache-Control on static
# files by extension — great for /_next/static/*.js|css (the filename
# itself changes when the content does, so a stale cache can't happen) but
# actively harmful for .html: it's never renamed between deploys, so a
# client that cached one keeps pointing at JS/CSS chunk hashes from a build
# that --delete already removed from the server on the next deploy. "no-cache"
# still lets the browser cache it — it just must revalidate (a cheap
# ETag-based 304) before trusting that copy, so this is correctness, not a
# performance regression. See logos/.htaccess and menu/.htaccess for the
# same fix applied to hand-placed images, which keep the same filename
# across deploys/admin uploads even when their content changes.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
